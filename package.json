{
    "name": "marklet",
    "version": "1.1.1",
    "type": "module",
    "private": true,
    "description": "Windows에서 마크다운 문서를 열어 읽고 가볍게 고치는 뷰어 (Rust · Tauri)",
    "license": "MIT",
    "author": "Alrimi Studio",
    "keywords": [
        "markdown",
        "markdown-viewer",
        "markdown-editor",
        "markdown-reader",
        "windows",
        "desktop",
        "katex",
        "mermaid",
        "cp949",
        "local-first",
        "offline",
        "viewer",
        "rust",
        "tauri"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "tauri build",
        "build:exe": "tauri build --no-bundle",
        "dist": "npm run notices && tauri build",
        "tauri": "tauri",
        "web": "vite build",
        "notices": "node scripts/make-notices.mjs",
        "icons": "node scripts/make-txt-icon.mjs",
        "docs:images": "node scripts/capture-docs.cjs",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.{ts,css,html}\"",
        "typecheck": "tsc --noEmit",
        "contrast": "node scripts/check-contrast.cjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:rust": "cargo test --release --manifest-path src-tauri/Cargo.toml"
    },
    "dependencies": {
        "@vscode/markdown-it-katex": "1.1.2",
        "dompurify": "3.4.12",
        "highlight.js": "11.11.1",
        "js-yaml": "4.3.1",
        "katex": "0.18.1",
        "markdown-it": "14.3.0",
        "markdown-it-anchor": "9.2.1",
        "markdown-it-footnote": "4.0.0",
        "markdown-it-task-lists": "2.1.1",
        "mermaid": "11.16.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.12.1",
        "@types/js-yaml": "4.0.9",
        "@types/markdown-it": "14.1.2",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jsdom": "^27.4.0",
        "prettier": "^3.7.4",
        "sharp": "^0.35.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    }
}
