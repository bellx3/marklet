{
    "name": "marklet",
    "version": "1.0.11",
    "type": "module",
    "main": "desktop/main.cjs",
    "private": true,
    "description": "Windows에서 마크다운 문서를 열어 읽고 가볍게 고치는 뷰어",
    "license": "MIT",
    "scripts": {
        "dev": "npm run desktop:dev",
        "build": "npm run desktop:build",
        "dist": "npm run desktop:dist",
        "desktop:build": "vite build -c vite.desktop.config.ts",
        "desktop:dev": "npm run desktop:build && electron .",
        "desktop:dist": "npm run desktop:build && electron-builder --win --x64",
        "lint": "eslint src --ext .ts",
        "format": "prettier --write \"src/**/*.{ts,css,html}\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@capacitor/android": "8.5.0",
        "@capacitor/app": "8.0.0",
        "@capacitor/browser": "8.0.0",
        "@capacitor/core": "8.5.0",
        "@capacitor/filesystem": "8.0.0",
        "@capacitor/haptics": "8.0.0",
        "@capacitor/preferences": "8.0.1",
        "@capacitor/share": "8.0.0",
        "@capacitor/splash-screen": "8.0.0",
        "@capacitor/status-bar": "8.0.0",
        "@vscode/markdown-it-katex": "1.1.2",
        "cordova-plugin-purchase": "13.18.0",
        "dompurify": "3.4.12",
        "highlight.js": "11.11.1",
        "js-yaml": "4.3.1",
        "katex": "0.18.1",
        "markdown-it": "14.3.0",
        "markdown-it-anchor": "9.2.1",
        "markdown-it-footnote": "4.0.0",
        "markdown-it-task-lists": "2.1.1",
        "mermaid": "11.16.0"
    },
    "devDependencies": {
        "@capacitor/cli": "8.5.0",
        "@types/js-yaml": "4.0.9",
        "@types/markdown-it": "14.1.2",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.51.0",
        "@typescript-eslint/parser": "^8.51.0",
        "electron": "^44.6.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "jsdom": "^27.4.0",
        "prettier": "^3.7.4",
        "sharp": "^0.35.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    },
    "author": "Alrimi Studio",
    "build": {
        "appId": "com.marklet.md.desktop",
        "productName": "Marklet",
        "copyright": "Alrimi Studio",
        "directories": {
            "output": "release-desktop"
        },
        "files": [
            "desktop/**/*",
            "dist-desktop/**/*",
            "package.json",
            "!node_modules"
        ],
        "asar": true,
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "desktop/icon.png",
            "artifactName": "Marklet-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "deleteAppDataOnUninstall": false,
            "shortcutName": "Marklet",
            "include": "desktop/installer.nsh"
        },
        "fileAssociations": [
            {
                "ext": [
                    "md",
                    "markdown",
                    "mdown",
                    "mkd"
                ],
                "name": "Marklet.Markdown",
                "description": "Markdown document",
                "role": "Viewer"
            }
        ],
        "electronLanguages": [
            "ko",
            "en-US"
        ]
    }
}
